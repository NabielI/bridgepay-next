// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  freelancer
  client
  admin
}

enum KycStatus {
  pending
  verified
  rejected
}

enum ProjectStatus {
  open
  active
  completed
  cancelled
}

enum ProjectApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum EscrowStatus {
  pending
  held
  released
}

enum EscrowPaymentMethod {
  master_account
  midtrans_snap
  qris_cross_border
  milestone_payout
}

enum ProjectFileKind {
  deliverable
  reference
}

enum GigStatus {
  draft
  published
  archived
}

enum GigGenerationMode {
  template
  ai
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  sessionVersion Int       @default(0)
  phone         String?
  role          Role      @default(freelancer)
  kycStatus     KycStatus @default(pending)
  skills        String[]
  rate          String?
  company       String?
  budget        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  clientProjects         Project[]            @relation("ClientProjects")
  sentMessages           Message[]            @relation("MessageSender")
  escrowEvents           EscrowEvent[]        @relation("EscrowActor")
  uploadedFiles          ProjectFile[]        @relation("ProjectFileUploader")
  kycSubmissions         KycSubmission[]      @relation("KycOwner")
  reviewedKycSubmissions KycSubmission[]      @relation("KycReviewer")
  gigs                   Gig[]                @relation("FreelancerGigs")
  gigDrafts              GigDraft[]           @relation("GigDraftAuthor")
  projectApplications    ProjectApplication[] @relation("FreelancerApplications")
  assignedProjects       Project[]            @relation("AssignedFreelancerProjects")
  passwordResetTokens    PasswordResetToken[]
}

model Project {
  id                   String        @id @default(cuid())
  title                String
  description          String        @db.Text
  category             String
  budget               Int
  currency             String        @default("USD")
  deadline             DateTime
  status               ProjectStatus @default(open)
  clientId             String
  assignedFreelancerId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  client             User                 @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  assignedFreelancer User?                @relation("AssignedFreelancerProjects", fields: [assignedFreelancerId], references: [id], onDelete: SetNull)
  messages           Message[]
  escrow             Escrow?
  files              ProjectFile[]
  applications       ProjectApplication[]

  @@index([clientId])
  @@index([assignedFreelancerId])
  @@index([status])
}

model ProjectApplication {
  id           String                   @id @default(cuid())
  projectId    String
  freelancerId String
  coverLetter  String?                  @db.Text
  status       ProjectApplicationStatus @default(pending)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer User    @relation("FreelancerApplications", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
  @@index([projectId, status])
  @@index([freelancerId, status])
}

model ProjectFile {
  id           String          @id @default(cuid())
  projectId    String
  uploaderId   String
  uploaderRole Role
  kind         ProjectFileKind
  fileName     String
  storagePath  String          @unique
  mimeType     String
  size         Int
  createdAt    DateTime        @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([uploaderId])
  @@index([kind])
}

model KycSubmission {
  id           String    @id @default(cuid())
  userId       String
  fileName     String
  storagePath  String    @unique
  mimeType     String
  size         Int
  status       KycStatus @default(pending)
  reviewNote   String?   @db.Text
  reviewerId   String?
  reviewerRole Role?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User  @relation("KycOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reviewerId])
  @@index([status])
}

model Gig {
  id            String    @id @default(cuid())
  freelancerId  String
  title         String
  description   String    @db.Text
  category      String
  skills        String[]
  startingPrice Int
  currency      String    @default("USD")
  packages      Json
  deliverables  String[]
  status        GigStatus @default(draft)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  freelancer User       @relation("FreelancerGigs", fields: [freelancerId], references: [id], onDelete: Cascade)
  drafts     GigDraft[]

  @@index([freelancerId, status])
  @@index([status, createdAt])
}

model GigDraft {
  id             String            @id @default(cuid())
  freelancerId   String
  gigId          String?
  brief          String            @db.Text
  category       String
  skills         String[]
  targetClient   String?
  tone           String
  startingPrice  Int
  currency       String            @default("USD")
  generated      Json
  generationMode GigGenerationMode @default(template)
  createdAt      DateTime          @default(now())

  freelancer User @relation("GigDraftAuthor", fields: [freelancerId], references: [id], onDelete: Cascade)
  gig        Gig? @relation(fields: [gigId], references: [id], onDelete: SetNull)

  @@index([freelancerId, createdAt])
  @@index([gigId])
}

model Escrow {
  id                    String              @id @default(cuid())
  projectId             String              @unique
  amount                Int
  currency              String              @default("USD")
  status                EscrowStatus        @default(pending)
  paymentMethod         EscrowPaymentMethod @default(master_account)
  exchangeRateSnapshot  Decimal?            @db.Decimal(18, 6)
  exchangeRateTimestamp DateTime?
  exchangeRateSource    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  EscrowEvent[]
  paymentTransactions PaymentTransaction[]
}

model PaymentTransaction {
  id                    String    @id @default(cuid())
  escrowId              String
  provider              String    @default("midtrans")
  providerOrderId       String    @unique
  providerTransactionId String?   @unique
  providerToken         String?
  providerRedirectUrl   String?
  amount                Int
  currency              String    @default("IDR")
  status                String    @default("pending")
  rawResponse           Json?
  rawNotification       Json?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId, createdAt])
  @@index([status, createdAt])
}

model EscrowEvent {
  id         String        @id @default(cuid())
  escrowId   String
  actorId    String
  actorRole  Role
  fromStatus EscrowStatus?
  toStatus   EscrowStatus
  note       String        @db.Text
  createdAt  DateTime      @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actor  User   @relation("EscrowActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([escrowId, createdAt])
  @@index([actorId])
}

model Message {
  id             String   @id @default(cuid())
  projectId      String
  senderId       String
  senderRole     Role
  body           String   @db.Text
  translatedBody String?  @db.Text
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([senderId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  id            String    @id @default(cuid())
  emailHash     String
  ipHash        String
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lastFailedAt  DateTime  @default(now())
  lockedUntil   DateTime?

  @@unique([emailHash, ipHash])
  @@index([lockedUntil])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId   String
  actorRole Role
  action    String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
